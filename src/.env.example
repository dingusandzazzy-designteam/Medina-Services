# Lead form → email (POST /api/lead)
# Copy to .env.local for local dev; set the same keys in Vercel →
# Project "medina-services" → Settings → Environment Variables (Production + Preview).

# Resend API key (https://resend.com → API Keys). Server-side only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the leads land.
LEAD_TO_EMAIL=info@medinaservices.us

# Sender. The DOMAIN must be verified in Resend (Domains → Add → add the DNS records)
# or every send is rejected. Ideally leads@medinaservices.us once we have DNS access;
# a domain we control works as a bridge, since reply-to is always the lead's address.
LEAD_FROM_EMAIL=Medina Services Website <leads@example.com>

# Optional — second recipient (e.g. the owner's personal inbox).
# LEAD_CC_EMAIL=

# Optional — "true" also sends a confirmation email to whoever submitted the form.
# LEAD_AUTOREPLY=false
